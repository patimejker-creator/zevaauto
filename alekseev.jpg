<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>VETOC.RU - Администрирование</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700;800;900&family=Unbounded:wght@600;700;800&display=swap" rel="stylesheet">
  <style>
    :root{--blue:#1A3A6B;--blue-mid:#1E4D8C;--blue-light:#3A72C4;--blue-faint:#EBF1FC;--ink:#0D1B33;--muted:#5A6E8F;--line:#E4ECF7;--bg:#F5F8FF;--danger:#c92a35;--r:12px;--r-lg:20px}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:'Onest',Arial,sans-serif}.shell{width:min(1060px,calc(100% - 32px));margin:0 auto;padding:38px 0 64px}.top{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:28px}.brand{display:flex;align-items:center;gap:12px;text-decoration:none;color:var(--blue)}.brand img{width:54px;height:54px;object-fit:contain;background:#fff;border-radius:var(--r);border:2px solid var(--line);box-shadow:0 2px 12px rgba(26,58,107,.08)}.brand strong{font-family:'Unbounded',sans-serif;font-size:18px;font-weight:800}.brand span{display:block;font-size:11px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;color:var(--muted);margin-top:4px}.back,.button{border:1.5px solid var(--line);border-radius:var(--r);padding:11px 16px;background:#fff;color:var(--blue);font:700 14px 'Onest',Arial,sans-serif;text-decoration:none;cursor:pointer;transition:.2s}.back:hover,.button:hover{transform:translateY(-1px);box-shadow:0 6px 16px rgba(26,58,107,.1)}.button.primary{background:var(--blue);border-color:var(--blue);color:#fff}.button.danger{border-color:#ffd5d9;color:var(--danger)}.panel{padding:30px;background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);box-shadow:0 6px 30px rgba(26,58,107,.08)}h1,h2{font-family:'Unbounded',sans-serif;letter-spacing:-.02em;font-weight:800}h1{margin:0 0 12px;font-size:clamp(24px,4vw,34px)}h2{margin:0;font-size:20px}.intro{margin:0 0 24px;color:var(--muted);font-weight:600;line-height:1.6}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.field{display:grid;gap:7px}.field.full{grid-column:1/-1}label{font-size:12px;font-weight:800;letter-spacing:.03em;text-transform:uppercase;color:var(--muted)}input,textarea,select{width:100%;padding:12px 14px;color:var(--ink);font:600 15px 'Onest',Arial,sans-serif;border:1.5px solid var(--line);border-radius:var(--r);background:#fff}textarea{min-height:120px;resize:vertical}.row{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-top:18px;flex-wrap:wrap}.check{display:flex;align-items:center;gap:9px;font-weight:700}.check input{width:17px;height:17px}.status{min-height:22px;margin:14px 0 0;color:var(--muted);font-size:14px;font-weight:700}.status.error{color:var(--danger)}.hidden{display:none!important}.manager{margin-top:28px}.items{display:grid;gap:12px;margin-top:16px}.item{display:grid;grid-template-columns:78px 1fr auto;gap:14px;align-items:center;padding:12px;border:1px solid var(--line);border-radius:var(--r)}.item img,.item video{width:78px;height:64px;object-fit:cover;border-radius:8px;background:var(--blue-faint)}.item h3{margin:0;font-size:15px;font-weight:700}.item p{margin:4px 0 0;color:var(--muted);font-size:13px;font-weight:600}.type{display:inline-block;margin-top:6px;color:var(--blue-light);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.03em}.notice{padding:16px 18px;border-left:4px solid var(--blue-light);border-radius:0 var(--r) var(--r) 0;background:var(--blue-faint);color:var(--blue);font-size:14px;line-height:1.6;font-weight:500}@media(max-width:680px){.shell{width:min(100% - 24px,1060px);padding-top:22px}.top{align-items:flex-start;flex-direction:column}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.item{grid-template-columns:64px 1fr}.item img,.item video{width:64px;height:56px}.item .button{grid-column:1/-1}}
  </style>
</head>
<body>
  <main class="shell">
    <header class="top"><a class="brand" href="index.html"><img src="assets/vetoc-logo.jpg" alt="VETOC"><span><strong>VETOC.RU</strong><span>Администрирование сайта</span></span></a><a class="back" href="index.html">На сайт</a></header>

    <section class="panel" id="setup-panel">
      <h1>Подключение хранилища</h1>
      <p class="intro">Чтобы войти и загружать материалы, сначала укажите данные Supabase в файле <code>assets/site-config.js</code>, затем выполните SQL-файл из этой папки.</p>
      <p class="notice">После подключения эта страница будет доступна только пользователям, которым вы создали учётную запись в Supabase Authentication.</p>
    </section>

    <section class="panel hidden" id="login-panel">
      <h1>Вход администратора</h1>
      <p class="intro">Используйте e-mail и пароль учётной записи администратора.</p>
      <form id="login-form" class="form-grid"><div class="field full"><label for="email">E-mail</label><input id="email" type="email" autocomplete="email" required></div><div class="field full"><label for="password">Пароль</label><input id="password" type="password" autocomplete="current-password" required></div><div class="field full"><button class="button primary" type="submit">Войти</button></div></form>
      <p class="status" id="login-status"></p>
    </section>

    <section class="hidden" id="admin-panel">
      <div class="panel"><div class="top"><div><h1>Материалы сайта</h1><p class="intro" style="margin:8px 0 0">Загружайте отзывы, фотографии, видео и сертификаты. Опубликованные материалы сразу появятся на главной странице.</p></div><button class="button" type="button" id="signout">Выйти</button></div>
        <form id="content-form" class="form-grid">
          <div class="field"><label for="kind">Раздел</label><select id="kind" required><option value="review">Отзыв</option><option value="event_photo">Фото с мероприятия</option><option value="video">Видео</option><option value="hall">Фотография зала</option><option value="certificate">Сертификат</option></select></div>
          <div class="field"><label for="title">Заголовок</label><input id="title" maxlength="120" required placeholder="Например: Практика по хирургии"></div>
          <div class="field"><label for="author">Автор отзыва или подпись</label><input id="author" maxlength="120" placeholder="Например: Анна, ветеринарный врач"></div>
          <div class="field"><label for="media">Файл</label><input id="media" type="file" accept="image/*,video/*"></div>
          <div class="field full"><label for="body">Текст отзыва или описание</label><textarea id="body" maxlength="2000" placeholder="Текст для публикации"></textarea></div>
          <label class="check field full"><input id="published" type="checkbox" checked> Опубликовать сразу</label>
          <div class="field full"><button class="button primary" id="save" type="submit">Загрузить и опубликовать</button></div>
        </form>
        <p class="status" id="content-status"></p>
      </div>
      <section class="panel manager"><h2>Загруженные материалы</h2><div class="items" id="items"></div></section>
    </section>
  </main>
  <script src="assets/site-config.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script>
    (function () {
      var config = window.VETOC_CONFIG || {};
      var configured = config.supabaseUrl && config.supabaseAnonKey;
      var setupPanel = document.getElementById("setup-panel");
      var loginPanel = document.getElementById("login-panel");
      var adminPanel = document.getElementById("admin-panel");
      var loginStatus = document.getElementById("login-status");
      var contentStatus = document.getElementById("content-status");
      var items = document.getElementById("items");
      if (!configured) return;
      setupPanel.classList.add("hidden");
      loginPanel.classList.remove("hidden");
      var client = window.supabase.createClient(config.supabaseUrl, config.supabaseAnonKey);

      function status(element, message, error) { element.textContent = message || ""; element.classList.toggle("error", Boolean(error)); }
      function escapeHtml(value) { return String(value || "").replace(/[&<>'"]/g, function (character) { return { "&":"&amp;", "<":"&lt;", ">":"&gt;", "'":"&#39;", '"':'&quot;' }[character]; }); }
      function getPreview(item) { if (!item.media_url) return '<div></div>'; return item.kind === "video" ? '<video src="' + escapeHtml(item.media_url) + '" muted></video>' : '<img src="' + escapeHtml(item.media_url) + '" alt="">'; }
      function showAdmin() { loginPanel.classList.add("hidden"); adminPanel.classList.remove("hidden"); loadItems(); }
      function showLogin() { adminPanel.classList.add("hidden"); loginPanel.classList.remove("hidden"); }
      async function loadItems() {
        var result = await client.from("vetoc_content").select("*").order("created_at", { ascending: false });
        if (result.error) { status(contentStatus, result.error.message, true); return; }
        if (!result.data.length) { items.innerHTML = '<p class="intro">Материалов пока нет.</p>'; return; }
        items.innerHTML = result.data.map(function (item) { return '<article class="item" data-id="' + item.id + '" data-path="' + escapeHtml(item.media_path || "") + '">' + getPreview(item) + '<div><h3>' + escapeHtml(item.title) + '</h3><p>' + escapeHtml(item.author || item.body || "Без описания") + '</p><span class="type">' + escapeHtml(item.kind) + (item.is_published ? " · опубликовано" : " · черновик") + '</span></div><button class="button danger" type="button" data-delete="' + item.id + '">Удалить</button></article>'; }).join("");
      }
      document.getElementById("login-form").addEventListener("submit", async function (event) {
        event.preventDefault(); status(loginStatus, "Выполняется вход...");
        var result = await client.auth.signInWithPassword({ email: document.getElementById("email").value, password: document.getElementById("password").value });
        if (result.error) { status(loginStatus, result.error.message, true); return; } showAdmin();
      });
      document.getElementById("signout").addEventListener("click", async function () { await client.auth.signOut(); showLogin(); });
      document.getElementById("content-form").addEventListener("submit", async function (event) {
        event.preventDefault();
        var save = document.getElementById("save"); save.disabled = true; status(contentStatus, "Загрузка материала...");
        var file = document.getElementById("media").files[0]; var mediaPath = null; var mediaUrl = null;
        try {
          if (file) {
            if (file.size > 100 * 1024 * 1024) throw new Error("Файл больше 100 МБ. Уменьшите размер видео или настройте лимит в Supabase.");
            mediaPath = "uploads/" + Date.now() + "-" + file.name.replace(/[^a-zA-Z0-9._-]/g, "-");
            var upload = await client.storage.from("vetoc-media").upload(mediaPath, file, { cacheControl: "3600", upsert: false });
            if (upload.error) throw upload.error;
            mediaUrl = client.storage.from("vetoc-media").getPublicUrl(mediaPath).data.publicUrl;
          }
          var record = { kind: document.getElementById("kind").value, title: document.getElementById("title").value.trim(), author: document.getElementById("author").value.trim() || null, body: document.getElementById("body").value.trim() || null, media_path: mediaPath, media_url: mediaUrl, is_published: document.getElementById("published").checked };
          var insert = await client.from("vetoc_content").insert(record);
          if (insert.error) throw insert.error;
          event.target.reset(); document.getElementById("published").checked = true; status(contentStatus, "Материал сохранён."); await loadItems();
        } catch (error) { status(contentStatus, error.message || "Не удалось сохранить материал.", true); }
        save.disabled = false;
      });
      items.addEventListener("click", async function (event) {
        var button = event.target.closest("[data-delete]"); if (!button) return;
        if (!window.confirm("Удалить этот материал с сайта?")) return;
        var card = button.closest(".item"); var id = button.dataset.delete; button.disabled = true;
        var removeRecord = await client.from("vetoc_content").delete().eq("id", id);
        if (removeRecord.error) { status(contentStatus, removeRecord.error.message, true); button.disabled = false; return; }
        if (card.dataset.path) await client.storage.from("vetoc-media").remove([card.dataset.path]);
        status(contentStatus, "Материал удалён."); await loadItems();
      });
      client.auth.getSession().then(function (result) { if (result.data.session) showAdmin(); });
    }());
  </script>
</body>
</html>
